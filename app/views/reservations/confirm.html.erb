<div class="reservation-confirm-container">
  <h2 class="form-title">予約確認</h2>
  <div class="reservation-confirm-card">
    <!-- 施設情報 -->
    <div class="room-summary">
      <% if @room.image.attached? %>
        <%= image_tag @room.image, class: "room-image-small" %>
      <% else %>
        <%= image_tag "default.png", class: "room-image-small" %>
      <% end %>
      <div>
        <h3><%= @room.name %></h3>
        <p><%= @room.price %>円 / 日</p>
      </div>
    </div>
    <!-- 予約内容 -->
    <% days = (@reservation.check_out_date - @reservation.check_in_date).to_i %>
    <% total = days * @room.price * @reservation.people_count %>
    <div class="confirm-info">
      <p>📅 チェックイン: <%= @reservation.check_in_date.strftime("%Y/%m/%d") %></p>
      <p>📅 チェックアウト: <%= @reservation.check_out_date.strftime("%Y/%m/%d") %></p>
      <p>👥 人数: <%= @reservation.people_count %>人</p>
      <p>🛏 宿泊日数: <%= days %>日</p>
      <p class="total-price">
        💰 合計金額: <%= total %>円
      </p>
    </div>
    <!-- ボタン -->
    <%= form_with model: @reservation, local: true do |f| %>
      <%= hidden_field_tag "reservation[room_id]", @room.id %>
      <%= hidden_field_tag "reservation[check_in_date]", @reservation.check_in_date %>
      <%= hidden_field_tag "reservation[check_out_date]", @reservation.check_out_date %>
      <%= hidden_field_tag "reservation[people_count]", @reservation.people_count %>
      <div class="confirm-actions">
        <%= link_to "← 戻る", new_reservation_path(room_id: @room.id), class: "back-btn" %>
        <%= f.submit "予約確定", class: "submit-btn" %>
      </div>
    <% end %>
  </div>
</div>
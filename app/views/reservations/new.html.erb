<div class="reservation-container">
  <h2 class="form-title">予約する</h2>
  <div class="reservation-card">
    <!-- 施設情報（上に表示するとUX良い） -->
    <div class="room-summary">
      <% if @room.image.attached? %>
        <%= image_tag @room.image, class: "room-image-small" %>
      <% else %>
        <%= image_tag "default.png", class: "room-image-small" %>
      <% end %>
      <div>
        <h3><%= @room.name %></h3>
        <p><%= @room.price %>円 / 日</p>
      </div>
    </div>
    <%= form_with model: @reservation, url: confirm_reservations_path, data: { turbo: false }, class: "form-container" do |f| %>
      <%= hidden_field_tag "reservation[room_id]", @room.id %>
      <div class="form-group">
        <%= f.label :check_in_date, "チェックイン" %>
        <%= f.date_field :check_in_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :check_out_date, "チェックアウト" %>
        <%= f.date_field :check_out_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :people_count, "人数" %>
        <%= f.number_field :people_count, class: "form-input", min: 1 %>
      </div>
      <%= f.submit "予約確認へ", class: "submit-btn" %>
    <% end %>
  </div>
</div>
<!-- app/views/sessions/new.html.erb -->

<h2>ログイン</h2>

<%= form_with url: login_path, local: true do %>
  <div>
    <%= label_tag :email %>
    <%= text_field_tag :email %>
  </div>

  <div>
    <%= label_tag :password %>
    <%= password_field_tag :password %>
  </div>

  <%= submit_tag "ログイン" %>
<% end %>
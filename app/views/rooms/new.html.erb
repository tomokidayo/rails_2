<!-- app/views/rooms/new.html.erb -->
<h2>施設登録</h2>
<%= form_with model: @room, local: true do |f| %>
  <% if @room.errors.any? %>
    <ul>
      <% @room.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <!-- app/views/rooms/new.html.erb -->
  <div>
    <%= f.label :image, "施設画像" %>
    <%= f.file_field :image %>
  </div>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :price %>
    <%= f.number_field :price %>
  </div>
  <div>
    <%= f.label :address %>
    <%= f.text_field :address %>
  </div>
  <%= f.submit "登録" %>
<% end %>
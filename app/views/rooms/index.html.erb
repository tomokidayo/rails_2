<div class="rooms-container">
  <h2 class="page-title">施設一覧</h2>
  <div class="rooms-header">
    <%# <%= link_to "施設登録", new_room_path, class: "new-room-btn" %>
    <%= form_with url: search_rooms_path, method: :get, local: true, class: "search-form" do |f| %>
      <%= f.text_field :area, placeholder: "エリア（例: 東京）", class: "search-input" %>
      <%= f.text_field :keyword, placeholder: "キーワード検索", class: "search-input" %>
      <%= f.submit "検索", class: "search-btn" %>
    <% end %>
  </div>
  <div class="rooms-list">
    <% @rooms.each do |room| %>
      <div class="room-card">
        <% if room.image.attached? %>
          <%= image_tag room.image, class: "room-image" %>
        <% else %>
          <%= image_tag "default.png", class: "room-image" %>
        <% end %>
        <!-- ここをリンク化 -->
        <h3 class="room-title">
          <%= link_to room.name, room_path(room), class: "room-link" %>
        </h3>
        <p class="room-description">
          <%= truncate(room.description, length: 80) %>
        </p>
        <p class="room-price"><%= room.price %>円 / 日</p>
      </div>
    <% end %>
  </div>
</div>
<!-- app/views/rooms/index.html.erb -->
<h2>施設一覧</h2>
<%= link_to "施設登録", new_room_path %>
<%= form_with url: area_search_rooms_path, method: :get, local: true do |f| %>
  <%= f.text_field :keyword, placeholder: "エリア（例: 東京）" %>
  <%= f.submit "検索" %>
<% end %>
<% @rooms.each do |room| %>
  <div>
    <h3><%= room.name %></h3>
    <p><%= room.description %></p>
    <p><%= room.price %>円</p>
    <%= link_to "詳細を見る", room_path(room) %>
  </div>
<% end %>
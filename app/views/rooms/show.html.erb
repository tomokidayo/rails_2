<div class="room-detail-container">
  <h2 class="room-detail-title">施設詳細</h2>
  <div class="room-detail-card">
    <div class="room-image-box">
      <% if @room.image.attached? %>
        <%= image_tag @room.image, class: "room-detail-image" %>
      <% else %>
        <%= image_tag "default.png", class: "room-detail-image" %>
      <% end %>
    </div>
    <div class="room-detail-info">
      <h3 class="room-name"><%= @room.name %></h3>
      <p class="room-price"><%= @room.price %>円 / 日</p>
      <p class="room-address">📍 <%= @room.address %></p>
      <div class="room-description">
        <strong>施設紹介</strong>
        <p><%= simple_format(@room.description) %></p>
      </div>
      <%= link_to "予約する", new_reservation_path(room_id: @room.id), class: "reserve-btn" %>
    </div>
  </div>
  <div class="back-link">
    <%= link_to "← 一覧に戻る", rooms_path %>
  </div>
</div>
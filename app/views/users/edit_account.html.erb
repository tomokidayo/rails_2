<h2 class="form-title">アカウント編集</h2>
<%= form_with model: @user, url: update_account_user_path, method: :patch, class: "form-container" do |f| %>
  <div class="form-group">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "form-input" %>
    <% @user.errors[:email].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :password, "パスワード（変更する場合のみ）" %>
    <%= f.password_field :password, class: "form-input" %>
    <% @user.errors[:password].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :password_confirmation, "確認用パスワード" %>
    <%= f.password_field :password_confirmation, class: "form-input" %>
    <% @user.errors[:password_confirmation].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <%= f.submit "更新", class: "submit-btn" %>
<% end %>
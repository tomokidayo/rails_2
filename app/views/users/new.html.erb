<%= form_with model: @user, data: { turbo: false } do |f| %>
  <%= @user.errors.full_messages %>
  <%= @user.object_id %>
  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
    <% @user.errors[:name].each do |message| %>
      <p style="color: red;"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
    <% @user.errors[:email].each do |message| %>
      <p style="color: red;"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
    <% @user.errors[:password].each do |message| %>
      <p style="color: red;"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= f.label :password_confirmation, "確認用パスワード" %>
    <%= f.password_field :password_confirmation %>
    <% @user.errors[:password_confirmation].each do |message| %>
      <p style="color: red;"><%= message %></p>
    <% end %>
  </div>
  <%= f.label :introduction %>
  <%= f.text_area :introduction %>
  <%= f.label :icon %>
  <%= f.file_field :icon %>
  <%= f.submit "登録" %>
<% end %>
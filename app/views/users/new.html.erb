<%= form_with model: @user, data: { turbo: false }, class: "form-container" do |f| %>
  <h2 class="form-title">新規登録</h2>
  <div class="form-group">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name, class: "form-input" %>
    <% @user.errors[:name].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "form-input" %>
    <% @user.errors[:email].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password, class: "form-input" %>
    <% @user.errors[:password].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :password_confirmation, "確認用パスワード" %>
    <%= f.password_field :password_confirmation, class: "form-input" %>
    <% @user.errors[:password_confirmation].each do |message| %>
      <p class="error-text"><%= message %></p>
    <% end %>
  </div>
  <div class="form-group">
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction, class: "form-input", rows: 4 %>
  </div>
  <div class="form-group">
    <%= f.label :icon, "アイコン画像" %>
    <%= f.file_field :icon, class: "form-input" %>
  </div>
  <%= f.submit "新しいアカウントを作成", class: "submit-btn" %>
<% end %>